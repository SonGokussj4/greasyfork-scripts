{
  "type": "module",
  "version": "0.9.0",
  "scripts": {
    "sync-version": "node scripts/sync-version.mjs",
    "build": "npm run sync-version && rollup -c",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:hover-preview": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/hoverPreviewProviders.test.cjs --runInBand",
    "watch": "npm run sync-version && rollup -c -w",
    "dev": "npm run sync-version && rollup -c -w"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.3",
    "chai": "^4.5.0",
    "cssnano": "^7.0.6",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss-cssnext": "^3.1.1",
    "postcss-nested": "^7.0.2",
    "postcss-simple-vars": "^7.0.1",
    "rollup": "^4.57.1",
    "rollup-plugin-css-only": "^4.5.2",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-string": "^3.0.0"
  }
